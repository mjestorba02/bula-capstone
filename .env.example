# Default remains demo so the existing capstone flow is not changed until credentials are supplied.
HELLOMONEY_MODE=demo

# PayMongo TEST (no real money)
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_PUBLIC_KEY=

# PayMongo LIVE (real money)
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_PUBLIC_KEY=

# Signing secret for the registered PayMongo webhook endpoint
PAYMONGO_WEBHOOK_SECRET=

# Login OTP email sender (Gmail SMTP). Use a Google App Password, not the normal Gmail password.
# Leave SMTP_USERNAME/SMTP_PASSWORD empty to run OTP in demo mode (code shown on the login screen).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Bestlink College Payment System
APP_TIMEZONE=Asia/Manila
